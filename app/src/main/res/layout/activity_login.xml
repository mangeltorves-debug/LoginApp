<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/color_background"
    tools:context=".LoginActivity">

    <!-- Título principal -->
    <TextView
        android:id="@+id/tv_title_login"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/login_title"
        android:textColor="@color/color_text_main"
        android:textSize="36sp"
        android:layout_marginTop="80dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent" />

    <!-- Campo de texto: Usuario -->
    <EditText
        android:id="@+id/et_username"
        android:layout_width="0dp"
        android:layout_height="78dp"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:layout_marginTop="40dp"
        android:background="@color/color_surface_input"
        android:hint="@string/login_hint_user"
        android:inputType="textEmailAddress"
        android:paddingStart="16dp"
        android:textColor="@color/color_text_main"
        android:textColorHint="@color/color_text_main"
        app:layout_constraintTop_toBottomOf="@id/tv_title_login"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent" />

    <!-- Campo de texto: Contraseña -->
    <EditText
        android:id="@+id/et_password"
        android:layout_width="0dp"
        android:layout_height="78dp"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:layout_marginTop="16dp"
        android:background="@color/color_surface_input"
        android:hint="@string/login_hint_password"
        android:inputType="textPassword"
        android:paddingStart="16dp"
        android:textColor="@color/color_text_main"
        android:textColorHint="@color/color_text_main"
        app:layout_constraintTop_toBottomOf="@id/et_username"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent" />

    <!-- Texto de Recordar -->
    <TextView
        android:id="@+id/tv_remember"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:layout_marginTop="24dp"
        android:text="@string/login_remember"
        android:textColor="@color/color_text_main"
        android:textSize="14sp"
        app:layout_constraintTop_toBottomOf="@id/et_password"
        app:layout_constraintLeft_toLeftOf="parent" />

    <!-- Switch de Recordar -->
    <Switch
        android:id="@+id/sw_remember"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="24dp"
        app:layout_constraintTop_toTopOf="@id/tv_remember"
        app:layout_constraintBottom_toBottomOf="@id/tv_remember"
        app:layout_constraintRight_toRightOf="parent" />

    <!-- Botón Principal -->
    <Button
        android:id="@+id/btn_login"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:layout_marginTop="32dp"
        android:backgroundTint="@color/color_button"
        android:text="@string/login_btn_text"
        android:textColor="@color/color_text_main"
        app:layout_constraintTop_toBottomOf="@id/tv_remember"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent" />

    <!-- Texto redes sociales -->
    <TextView
        android:id="@+id/tv_social_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="40dp"
        android:text="Iniciar sesion con correo"
        android:textColor="@color/color_text_main"
        android:textSize="14sp"
        app:layout_constraintTop_toBottomOf="@id/btn_login"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent" />

    <!-- Contenedor horizontal para los iconos -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:orientation="horizontal"
        app:layout_constraintTop_toBottomOf="@id/tv_social_title"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent">

        <ImageView
            android:id="@+id/iv_gmail"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginEnd="16dp"
            android:src="@drawable/ic_gmail" />

        <ImageView
            android:id="@+id/iv_icloud"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginEnd="16dp"
            android:src="@drawable/ic_icloud" />

        <ImageView
            android:id="@+id/iv_outlook"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/ic_outlook" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>